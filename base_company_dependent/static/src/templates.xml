<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ──────────────────────────────────────────────────────────────────── -->
    <!--  SelectionField (company_dependent extension)                        -->
    <!-- ──────────────────────────────────────────────────────────────────── -->
    <!--
        When company_dependent: wraps content in a flex row and appends the
        building-icon button.  Non-CD fields render identically to the original
        web.SelectionField template (no extra DOM).
    -->
    <t t-name="base_company_dependent.SelectionField">
        <t t-if="this.isCompanyDependent">
            <div class="o_cd_wrapper d-inline-flex align-items-center gap-1 w-100"
                 t-att-class="{ 'o_cd_fallback': this._cdState.isSpecific === false }">
                <t t-if="this.props.readonly">
                    <span t-out="this.string" t-att-raw-value="this.value" class="flex-grow-1"/>
                </t>
                <t t-else="">
                    <SelectMenu autoSort="false" class="'border-0 flex-grow-1'"
                        menuClass="'o_field_selection_menu'"
                        value="this.value" choices="this.choices" onSelect.bind="this.onChange"
                        placeholder="this.props.placeholder" id="this.props.id"
                        searchable="!this.isBottomSheet" required="this.props.required"/>
                </t>
                <CompanyDependentButton
                    fieldName="this.props.name"
                    fieldString="this.props.record.fields[this.props.name].string || this.props.name"
                    required="this.props.record._isRequired(this.props.name)"
                    record="this.props.record"
                    isSpecific="this._cdState.isSpecific"
                    onSaved="() => this._loadCDMeta()"
                />
            </div>
        </t>
        <t t-else="">
            <t t-if="this.props.readonly">
                <span t-out="this.string" t-att-raw-value="this.value"/>
            </t>
            <t t-else="">
                <SelectMenu autoSort="false" class="'border-0'"
                    menuClass="'o_field_selection_menu'"
                    value="this.value" choices="this.choices" onSelect.bind="this.onChange"
                    placeholder="this.props.placeholder" id="this.props.id"
                    searchable="!this.isBottomSheet" required="this.props.required"/>
            </t>
        </t>
    </t>

    <!-- ──────────────────────────────────────────────────────────────────── -->
    <!--  CharField (company_dependent extension)                             -->
    <!-- ──────────────────────────────────────────────────────────────────── -->
    <t t-name="base_company_dependent.CharField">
        <t t-if="this.isCompanyDependent">
            <div class="o_cd_wrapper d-inline-flex align-items-center gap-1 w-100"
                 t-att-class="{ 'o_cd_fallback': this._cdState.isSpecific === false }">
                <t t-if="this.props.readonly">
                    <span class="flex-grow-1" t-out="this.formattedValue"/>
                </t>
                <t t-else="">
                    <input
                        class="o_input flex-grow-1"
                        t-att-class="{ 'o_field_translate': this.isTranslatable, 'o_field_placeholder': this.hasDynamicPlaceholder }"
                        t-att-id="this.props.id"
                        t-att-type="this.props.isPassword ? 'password' : 'text'"
                        t-att-autocomplete="this.props.autocomplete or (this.props.isPassword ? 'new-password' : 'off')"
                        t-att-maxlength="this.maxLength > 0 and this.maxLength"
                        t-att-placeholder="this.props.placeholder"
                        t-on-blur="this.onBlur"
                        t-ref="this.input"
                    />
                    <div class="o_field_input_buttons">
                        <TranslationButton t-if="this.isTranslatable" fieldName="this.props.name" record="this.props.record"/>
                        <button t-if="this.hasDynamicPlaceholder"
                            class="btn btn-link oi"
                            data-icon="wand_stars"
                            title="Insert Field"
                            t-on-click="this.onDynamicPlaceholderOpen"
                        />
                    </div>
                </t>
                <CompanyDependentButton
                    fieldName="this.props.name"
                    fieldString="this.props.record.fields[this.props.name].string || this.props.name"
                    required="this.props.record._isRequired(this.props.name)"
                    record="this.props.record"
                    isSpecific="this._cdState.isSpecific"
                    onSaved="() => this._loadCDMeta()"
                />
            </div>
        </t>
        <t t-else="">
            <t t-if="this.props.readonly">
                <span t-out="this.formattedValue"/>
            </t>
            <t t-else="">
                <input
                    class="o_input"
                    t-att-class="{ 'o_field_translate': this.isTranslatable, 'o_field_placeholder': this.hasDynamicPlaceholder }"
                    t-att-id="this.props.id"
                    t-att-type="this.props.isPassword ? 'password' : 'text'"
                    t-att-autocomplete="this.props.autocomplete or (this.props.isPassword ? 'new-password' : 'off')"
                    t-att-maxlength="this.maxLength > 0 and this.maxLength"
                    t-att-placeholder="this.props.placeholder"
                    t-on-blur="this.onBlur"
                    t-ref="this.input"
                />
                <div class="o_field_input_buttons">
                    <TranslationButton t-if="this.isTranslatable" fieldName="this.props.name" record="this.props.record"/>
                    <button t-if="this.hasDynamicPlaceholder"
                        class="btn btn-link oi"
                        data-icon="wand_stars"
                        title="Insert Field"
                        t-on-click="this.onDynamicPlaceholderOpen"
                    />
                </div>
            </t>
        </t>
    </t>

    <!-- ──────────────────────────────────────────────────────────────────── -->
    <!--  IntegerField (company_dependent extension)                          -->
    <!-- ──────────────────────────────────────────────────────────────────── -->
    <t t-name="base_company_dependent.IntegerField">
        <t t-if="this.isCompanyDependent">
            <div class="o_cd_wrapper d-inline-flex align-items-center gap-1 w-100"
                 t-att-class="{ 'o_cd_fallback': this._cdState.isSpecific === false }">
                <span t-if="this.props.readonly" class="flex-grow-1" t-out="this.formattedValue"/>
                <input t-else=""
                    t-ref="this.numpadDecimalRef"
                    t-on-focusin="this.onFocusIn"
                    t-on-focusout="this.onFocusOut"
                    t-att-id="this.props.id"
                    t-att-min="this.props.min"
                    t-att-max="this.props.max"
                    t-att-type="this.props.inputType"
                    inputmode="numeric"
                    class="o_input flex-grow-1"
                    autocomplete="off"
                    t-att-step="this.props.step"
                />
                <CompanyDependentButton
                    fieldName="this.props.name"
                    fieldString="this.props.record.fields[this.props.name].string || this.props.name"
                    required="this.props.record._isRequired(this.props.name)"
                    record="this.props.record"
                    isSpecific="this._cdState.isSpecific"
                    onSaved="() => this._loadCDMeta()"
                />
            </div>
        </t>
        <t t-else="">
            <span t-if="this.props.readonly" t-out="this.formattedValue"/>
            <input t-else=""
                t-ref="this.numpadDecimalRef"
                t-on-focusin="this.onFocusIn"
                t-on-focusout="this.onFocusOut"
                t-att-id="this.props.id"
                t-att-min="this.props.min"
                t-att-max="this.props.max"
                t-att-type="this.props.inputType"
                inputmode="numeric"
                class="o_input"
                autocomplete="off"
                t-att-step="this.props.step"
            />
        </t>
    </t>

    <!-- ──────────────────────────────────────────────────────────────────── -->
    <!--  FloatField (company_dependent extension)                            -->
    <!-- ──────────────────────────────────────────────────────────────────── -->
    <t t-name="base_company_dependent.FloatField">
        <t t-if="this.isCompanyDependent">
            <div class="o_cd_wrapper d-inline-flex align-items-center gap-1 w-100"
                 t-att-class="{ 'o_cd_fallback': this._cdState.isSpecific === false }">
                <span t-if="this.props.readonly" class="flex-grow-1" t-out="this.formattedValue"/>
                <input t-else=""
                    t-on-focusin="this.onFocusIn"
                    t-on-focusout="this.onFocusOut"
                    t-att-id="this.props.id"
                    t-ref="this.numpadDecimalRef"
                    t-att-type="this.props.inputType"
                    inputmode="decimal"
                    class="o_input flex-grow-1"
                    autocomplete="off"
                    t-att-step="this.props.step"
                />
                <CompanyDependentButton
                    fieldName="this.props.name"
                    fieldString="this.props.record.fields[this.props.name].string || this.props.name"
                    required="this.props.record._isRequired(this.props.name)"
                    record="this.props.record"
                    isSpecific="this._cdState.isSpecific"
                    onSaved="() => this._loadCDMeta()"
                />
            </div>
        </t>
        <t t-else="">
            <span t-if="this.props.readonly" t-out="this.formattedValue"/>
            <input t-else=""
                t-on-focusin="this.onFocusIn"
                t-on-focusout="this.onFocusOut"
                t-att-id="this.props.id"
                t-ref="this.numpadDecimalRef"
                t-att-type="this.props.inputType"
                inputmode="decimal"
                class="o_input"
                autocomplete="off"
                t-att-step="this.props.step"
            />
        </t>
    </t>

    <!-- ──────────────────────────────────────────────────────────────────── -->
    <!--  MonetaryField (company_dependent extension)                         -->
    <!-- ──────────────────────────────────────────────────────────────────── -->
    <t t-name="base_company_dependent.MonetaryField">
        <t t-if="this.isCompanyDependent">
            <div class="o_cd_wrapper d-inline-flex align-items-center gap-1 w-100"
                 t-att-class="{ 'o_cd_fallback': this._cdState.isSpecific === false }">
                <span t-if="this.props.readonly" class="flex-grow-1" t-out="this.formattedValue"/>
                <div t-else="" class="text-nowrap d-inline-flex flex-grow-1 align-items-baseline position-relative">
                    <span class="o_input position-absolute pe-none d-flex w-100">
                        <span t-if="!this.props.hideSymbol and this.currency and this.currency.position === 'before'" t-out="this.currencySymbol + this.nbsp"/>
                        <span class="opacity-0 d-inline-block overflow-hidden mw-100 o_monetary_ghost_value" t-out="this.state.value"/>
                        <span t-if="!this.props.hideSymbol and this.currency and this.currency.position === 'after'" t-out="this.nbsp + this.currencySymbol"/>
                    </span>
                    <span class="opacity-0" t-if="!this.props.hideSymbol and this.currency and this.currency.position === 'before'" t-out="this.currencySymbol + this.nbsp"/>
                    <input t-ref="this.numpadDecimalRef" t-on-input="this.onInput" t-att-id="this.props.id" t-att-type="this.props.inputType" class="o_input flex-grow-1 flex-shrink-1" autocomplete="off"/>
                    <span class="opacity-0" t-if="!this.props.hideSymbol and this.currency and this.currency.position === 'after'" t-out="this.nbsp + this.currencySymbol"/>
                </div>
                <CompanyDependentButton
                    fieldName="this.props.name"
                    fieldString="this.props.record.fields[this.props.name].string || this.props.name"
                    required="this.props.record._isRequired(this.props.name)"
                    record="this.props.record"
                    isSpecific="this._cdState.isSpecific"
                    onSaved="() => this._loadCDMeta()"
                />
            </div>
        </t>
        <t t-else="">
            <span t-if="this.props.readonly" t-out="this.formattedValue"/>
            <div t-else="" class="text-nowrap d-inline-flex w-100 align-items-baseline position-relative">
                <span class="o_input position-absolute pe-none d-flex w-100">
                    <span t-if="!this.props.hideSymbol and this.currency and this.currency.position === 'before'" t-out="this.currencySymbol + this.nbsp"/>
                    <span class="opacity-0 d-inline-block overflow-hidden mw-100 o_monetary_ghost_value" t-out="this.state.value"/>
                    <span t-if="!this.props.hideSymbol and this.currency and this.currency.position === 'after'" t-out="this.nbsp + this.currencySymbol"/>
                </span>
                <span class="opacity-0" t-if="!this.props.hideSymbol and this.currency and this.currency.position === 'before'" t-out="this.currencySymbol + this.nbsp"/>
                <input t-ref="this.numpadDecimalRef" t-on-input="this.onInput" t-att-id="this.props.id" t-att-type="this.props.inputType" class="o_input flex-grow-1 flex-shrink-1" autocomplete="off"/>
                <span class="opacity-0" t-if="!this.props.hideSymbol and this.currency and this.currency.position === 'after'" t-out="this.nbsp + this.currencySymbol"/>
            </div>
        </t>
    </t>

    <!-- ──────────────────────────────────────────────────────────────────── -->
    <!--  BooleanField (company_dependent extension)                          -->
    <!-- ──────────────────────────────────────────────────────────────────── -->
    <t t-name="base_company_dependent.BooleanField">
        <t t-if="this.isCompanyDependent">
            <div class="o_cd_wrapper d-inline-flex align-items-center gap-1"
                 t-att-class="{ 'o_cd_fallback': this._cdState.isSpecific === false }">
                <CheckBox id="this.props.id" value="this.state.value" disabled="this.props.readonly" onChange.bind="this.onChange"
                    className="this.displayAsToggle ? 'o_field_boolean o_boolean_toggle form-switch' : 'd-inline-block'"
                ><t t-if="this.displayAsToggle">
                    &#8203; <!-- Zero width space needed to set height -->
                </t></CheckBox>
                <CompanyDependentButton
                    fieldName="this.props.name"
                    fieldString="this.props.record.fields[this.props.name].string || this.props.name"
                    required="this.props.record._isRequired(this.props.name)"
                    record="this.props.record"
                    isSpecific="this._cdState.isSpecific"
                    onSaved="() => this._loadCDMeta()"
                />
            </div>
        </t>
        <t t-else="">
            <CheckBox id="this.props.id" value="this.state.value" disabled="this.props.readonly" onChange.bind="this.onChange"
                className="this.displayAsToggle ? 'o_field_boolean o_boolean_toggle form-switch' : 'd-inline-block'"
            ><t t-if="this.displayAsToggle">
                &#8203; <!-- Zero width space needed to set height -->
            </t></CheckBox>
        </t>
    </t>

    <!-- ──────────────────────────────────────────────────────────────────── -->
    <!--  DateTimeField (company_dependent extension)                         -->
    <!--  Uses t-inherit-mode="primary" to add the button inside the          -->
    <!--  existing d-flex root container without duplicating the template.    -->
    <!-- ──────────────────────────────────────────────────────────────────── -->
    <t t-name="base_company_dependent.DateTimeField"
       t-inherit="web.DateTimeField"
       t-inherit-mode="primary">
        <xpath expr="//div[@t-ref='this.rootRef']" position="attributes">
            <attribute name="t-att-class">this.isCompanyDependent and this._cdState.isSpecific === false ? 'o_cd_fallback' : ''</attribute>
        </xpath>
        <xpath expr="//div[@t-ref='this.rootRef']" position="inside">
            <CompanyDependentButton
                t-if="this.isCompanyDependent"
                fieldName="this.props.name"
                fieldString="this.props.record.fields[this.props.name].string || this.props.name"
                required="this.props.record._isRequired(this.props.name)"
                record="this.props.record"
                isSpecific="this._cdState.isSpecific"
                onSaved="() => this._loadCDMeta()"
            />
        </xpath>
    </t>

    <!--
        Template extendido de Many2OneField.
        Reemplaza al original ``web.Many2OneField`` añadiendo:
          - wrapper div con clase dinámica o_cd_fallback (activa el estilo muted).
          - CompanyDependentButton justo a la derecha del input.
    -->
    <t t-name="base_company_dependent.Many2OneField">
        <!--
            Usamos un wrapper posicionado para poder colocar el botón inline.
            La clase o_cd_fallback activa el CSS que pone el texto en gris.
        -->
        <div class="o_cd_m2o_wrapper d-flex align-items-center gap-1 w-100"
             t-att-class="{ 'o_cd_fallback': this.isCompanyDependent &amp;&amp; this._cdState.isSpecific === false }">
            <div class="flex-grow-1">
                <Many2One t-props="this.m2oProps"/>
            </div>
            <CompanyDependentButton
                t-if="this.isCompanyDependent"
                fieldName="this.props.name"
                fieldString="this.props.record.fields[this.props.name].string || this.props.name"
                required="this.props.record._isRequired(this.props.name)"
                record="this.props.record"
                isSpecific="this._cdState.isSpecific"
                onSaved="() => this._loadCDMeta()"
            />
        </div>
    </t>

    <!-- ──────────────────────────────────────────────────────────────────── -->
    <!--  CompanyDependentButton                                              -->
    <!-- ──────────────────────────────────────────────────────────────────── -->
    <t t-name="base_company_dependent.CompanyDependentButton">
        <button
            class="o_cd_btn btn btn-link p-0 ms-1"
            type="button"
            t-att-title="this.title"
            t-on-click.prevent="this.onClick"
        >
            <i data-icon="business" t-att-class="{
                'oi': true,
                'text-primary': this.props.isSpecific === true,
                'text-muted':   this.props.isSpecific === false,
                'text-secondary opacity-50': this.props.isSpecific === null,
            }"/>
        </button>
    </t>

    <!-- ──────────────────────────────────────────────────────────────────── -->
    <!--  CompanyDependentDialog                                              -->
    <!-- ──────────────────────────────────────────────────────────────────── -->
    <t t-name="base_company_dependent.CompanyDependentDialog">
        <Dialog t-props="{ title: this.title, size: 'lg' }">
            <div class="o_cd_dialog">

                <!-- Estado de carga -->
                <t t-if="!this.state.rows.length">
                    <div class="text-center text-muted py-4">
                        <i class="oi oi-spin me-2" data-icon="autorenew"/>
                        <t t-out="this.loadingText"/>
                    </div>
                </t>

                <!-- Tabla jerárquica de valores -->
                <t t-else="">
                    <table class="table table-sm align-middle o_cd_table">
                        <thead>
                            <tr>
                                <th><t t-out="this.labelCompany"/></th>
                                <th><t t-out="this.labelValue"/></th>
                                <th class="text-center o_cd_col_status"><t t-out="this.labelStatus"/></th>
                                <th class="text-center o_cd_col_actions">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="this.orderedRows" t-as="item" t-key="item.row.company_id">
                                <t t-set="row" t-value="item.row"/>
                                <t t-set="depth" t-value="item.depth"/>
                                <tr t-att-class="'o_cd_row o_cd_depth_' + depth + (this.isSpecificRow(row) ? ' o_cd_row_specific' : ' o_cd_row_default')">

                                    <!-- Columna 1: nombre de la compañía con indentación -->
                                    <td class="o_cd_company_cell">
                                        <div class="o_cd_company_name" t-att-style="'padding-left: ' + (depth * 20) + 'px'">
                                            <!-- Indicador de nivel: guion/rama visual -->
                                            <span t-if="depth > 0" class="o_cd_tree_indent">
                                                <i class="oi o_cd_tree_icon" data-icon="subdirectory_arrow_right"/>
                                            </span>
                                            <i class="oi o_cd_company_icon me-1" data-icon="business"
                                               t-att-class="{ 'text-primary': depth === 0, 'text-muted': depth > 0 }"/>
                                            <span t-out="row.company_name"/>
                                        </div>
                                    </td>

                                    <!-- Columna 2: input de valor según tipo de campo -->
                                    <td>
                                        <!-- Many2One -->
                                        <t t-if="this.state.fieldType === 'many2one'">
                                            <div t-att-class="{ 'o_cd_fallback': !this.isSpecificRow(row) }">
                                                <AutoComplete
                                                    t-key="this.getAutoCompleteKey(row)"
                                                    value="this.getDisplayValue(row)"
                                                    sources="this.getAutoCompleteSources(row)"
                                                    onChange.bind="(info) => this.onAutoCompleteChange(row, info)"
                                                    placeholder="this.getRowPlaceholder(row)"
                                                    class="'o_input w-100'"
                                                />
                                            </div>
                                        </t>

                                        <!-- Selection -->
                                        <t t-elif="this.state.fieldType === 'selection'">
                                            <select
                                                t-att-class="'o_input w-100' + (!this.isSpecificRow(row) ? ' text-muted' : '')"
                                                t-on-change="(ev) => this.onSelectionChange(row, ev)"
                                            >
                                                <option value="" t-att-selected="this._getEffectiveRow(row).value_id === null || this._getEffectiveRow(row).value_id === undefined">—</option>
                                                <t t-foreach="this.state.selectionOptions" t-as="opt" t-key="opt[0]">
                                                    <option
                                                        t-att-value="opt[0] === false ? '__false__' : opt[0]"
                                                        t-att-selected="this._getEffectiveRow(row).value_id === opt[0]"
                                                    >
                                                        <t t-out="opt[1]"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </t>

                                        <!-- Float / Integer / Monetary -->
                                        <t t-elif="this.state.fieldType === 'float' || this.state.fieldType === 'integer' || this.state.fieldType === 'monetary'">
                                            <input
                                                type="number"
                                                t-att-class="'o_input w-100' + (!this.isSpecificRow(row) ? ' text-muted' : '')"
                                                t-att-value="this.getDisplayValue(row)"
                                                t-att-step="this.state.fieldType === 'integer' ? '1' : 'any'"
                                                t-on-change="(ev) => this.onScalarChange(row, ev)"
                                            />
                                        </t>

                                        <!-- Boolean -->
                                        <t t-elif="this.state.fieldType === 'boolean'">
                                            <div class="form-check form-switch d-flex justify-content-start ms-1">
                                                <input
                                                    class="form-check-input"
                                                    type="checkbox"
                                                    t-att-checked="this._getEffectiveRow(row).value_id"
                                                    t-on-change="(ev) => this.onBooleanChange(row, ev)"
                                                />
                                            </div>
                                        </t>

                                        <!-- Date -->
                                        <t t-elif="this.state.fieldType === 'date'">
                                            <input
                                                type="date"
                                                t-att-class="'o_input w-100' + (!this.isSpecificRow(row) ? ' text-muted' : '')"
                                                t-att-value="this.getDisplayValue(row)"
                                                t-on-change="(ev) => this.onScalarChange(row, ev)"
                                            />
                                        </t>

                                        <!-- Datetime -->
                                        <t t-elif="this.state.fieldType === 'datetime'">
                                            <input
                                                type="datetime-local"
                                                t-att-class="'o_input w-100' + (!this.isSpecificRow(row) ? ' text-muted' : '')"
                                                t-att-value="this.getDisplayValue(row)"
                                                t-on-change="(ev) => this.onScalarChange(row, ev)"
                                            />
                                        </t>

                                        <!-- Char / Text (fallback) -->
                                        <t t-else="">
                                            <input
                                                type="text"
                                                t-att-class="'o_input w-100' + (!this.isSpecificRow(row) ? ' text-muted' : '')"
                                                t-att-value="this.getDisplayValue(row)"
                                                t-on-change="(ev) => this.onScalarChange(row, ev)"
                                            />
                                        </t>
                                    </td>

                                    <!-- Columna 3: badge de estado -->
                                    <td class="text-center o_cd_col_status">
                                        <t t-if="this.isSpecificRow(row)">
                                            <span class="badge o_cd_badge_specific">
                                                <i class="oi me-1" data-icon="lock"/><t t-out="this.labelSpecific"/>
                                            </span>
                                        </t>
                                        <t t-else="">
                                            <span class="badge o_cd_badge_default">
                                                <i class="oi me-1" data-icon="public"/><t t-out="this.labelDefault"/>
                                            </span>
                                        </t>
                                    </td>

                                    <!-- Columna 4: acciones (Copy + Reset) -->
                                    <td class="text-center o_cd_col_actions">
                                        <div class="d-flex gap-1 justify-content-center">
                                            <!-- Copy button: only visible when the company has children -->
                                            <button
                                                t-if="row.has_children"
                                                type="button"
                                                class="btn btn-sm btn-outline-primary o_cd_copy_btn"
                                                t-att-title="this.copyButtonTitle"
                                                t-on-click="() => this.onCopyToChildren(row)"
                                            >
                                                <i class="oi me-1" data-icon="content_copy"/><t t-out="this.labelCopy"/>
                                            </button>

                                            <!-- Botón Reset -->
                                            <button
                                                type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                t-att-disabled="!this.isSpecificRow(row)"
                                                t-att-title="this.resetButtonTitle"
                                                t-on-click="() => this.onResetRow(row)"
                                            >
                                                <i class="oi" data-icon="undo"/>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Nota aclaratoria -->
                    <div class="alert alert-info py-2 small mt-2">
                        <i class="oi me-1" data-icon="undo"/>
                        <strong><t t-out="this.footerNoteHtml.reset"/></strong>
                        <em><t t-out="this.footerNoteHtml.resetDesc"/></em>
                        <span class="mx-2 text-muted">·</span>
                        <i class="oi me-1" data-icon="content_copy"/>
                        <strong><t t-out="this.footerNoteHtml.copy"/></strong>
                        <em><t t-out="this.footerNoteHtml.copyDesc"/></em>
                    </div>
                </t>
            </div>

            <!-- Footer del diálogo -->
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="this.onSave">
                    <i class="oi me-1" data-icon="save"/><t t-out="this.labelSave"/>
                </button>
                <button class="btn btn-secondary" t-on-click="this.props.close">
                    <t t-out="this.labelDiscard"/>
                </button>
            </t>
        </Dialog>
    </t>

</templates>
