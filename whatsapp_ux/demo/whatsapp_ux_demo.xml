<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="whatsapp_ux_demo_template" model="whatsapp.template">
        <field name="name">Demo Bulk Message</field>
        <field name="template_name">whatsapp_ux_demo_template</field>
        <field name="body">Hello {{1}}, this is a demo bulk WhatsApp message.</field>
        <field name="status">approved</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="phone_field">phone</field>
        <field name="wa_account_id" ref="whatsapp.demo_whatsapp_account"/>
        <field name="wa_template_uid">whatsapp_ux_demo_template</field>
        <field name="variable_ids" eval="[
            (5, 0, 0),
            (0, 0, {
                'name': '{{1}}',
                'demo_value': 'Customer',
                'line_type': 'body',
                'field_type': 'field',
                'field_name': 'name',
            }),
        ]"/>
    </record>
</odoo>
