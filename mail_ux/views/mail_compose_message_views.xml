<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="email_compose_message_wizard_form" model="ir.ui.view">
        <field name="model">mail.compose.message</field>
        <field name="inherit_id" ref="mail.email_compose_message_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='template_id']" position="before">
                <!-- the client has to send these back for the reuse to work -->
                <field name="attachments_source_key" invisible="1"/>
                <field name="attachments_source_ids" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
