<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_bg_job_list" model="ir.ui.view">
        <field name="name">bg.job.list</field>
        <field name="model">bg.job</field>
        <field name="arch" type="xml">
            <list string="Background Jobs" create="false" delete="false"
                  decoration-info="state == 'enqueued'"
                  decoration-warning="state == 'running'"
                  decoration-success="state == 'done'"
                  decoration-danger="state == 'failed'"
                  decoration-muted="state == 'canceled'">
                <field string="" name="priority"/>
                <field name="name"/>
                <field name="model" optional="hide"/>
                <field name="method" optional="hide"/>
                <field name="batch_id" optional="hide"/>
                <field name="batch_progress_count" string="Progress" optional="show"/>
                <field name="batch_job_count" string="Batch Size" optional="show"/>
                <field name="state"/>
                <field name="create_date"/>
                <field name="duration"/>
                <field string="Retries" name="retry_count" optional="hide"/>
                <button name="action_open_records" string="Open Records" type="object" icon="fa-bars"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_bg_job_form" model="ir.ui.view">
        <field name="name">bg.job.form</field>
        <field name="model">bg.job</field>
        <field name="arch" type="xml">
            <form string="Background Job" create="false" delete="false">
                <header>
                    <button name="action_retry" string="Retry" type="object"
                            class="btn-primary" invisible="state != 'failed'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            class="btn-secondary" invisible="state != 'enqueued'"/>
                    <field name="state" widget="statusbar" statusbar_visible="enqueued,running,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_open_batch_jobs" type="object" icon="fa-tasks" invisible="batch_job_count &lt;= 1">
                            <field name="batch_job_count" widget="statinfo" string="Jobs in Batch"/>
                        </button>
                        <button class="oe_stat_button" name="action_open_records" string="Open Records" type="object" icon="fa-bars"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="model"/>
                            <field name="method"/>
                            <field name="create_uid"/>
                        </group>
                        <group>
                            <field name="priority"/>
                            <field name="max_retries"/>
                            <field name="retry_count"/>
                        </group>
                    </group>
                    <group>
                        <group string="General Information">
                            <group>
                                <field name="create_date"/>
                                <field name="start_time"/>
                                <field name="end_time"/>
                                <field name="duration"/>
                            </group>
                        </group>
                        <group string="Batch Information">
                            <field name="batch_id"/>
                            <field name="batch_progress_count"/>
                            <field name="batch_job_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Error" name="error" invisible="not error_message">
                            <field name="error_message" widget="ace"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_bg_job_search" model="ir.ui.view">
        <field name="name">bg.job.search</field>
        <field name="model">bg.job</field>
        <field name="arch" type="xml">
            <search string="Background Jobs">
                <field name="name"/>
                <field name="model"/>
                <field name="method"/>
                <field name="create_date"/>
                <field name="create_uid"/>
                <field name="batch_id"/>
                <separator/>
                <filter string="Enqueued" name="enqueued" domain="[('state', '=', 'enqueued')]"/>
                <filter string="Running" name="running" domain="[('state', '=', 'running')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/>
                <filter string="Canceled" name="canceled" domain="[('state', '=', 'canceled')]"/>
                <separator/>
                <filter string="Today" name="today" domain="[('create_date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <filter string="This Week" name="this_week" domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Model" name="group_model" context="{'group_by': 'model'}"/>
                    <filter string="Batch" name="group_batch" context="{'group_by': 'batch_id'}"/>
                    <filter string="User" name="group_user" context="{'group_by': 'create_uid'}"/>
                    <filter string="Creation Date" name="group_create_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_bg_job" model="ir.actions.act_window">
        <field name="name">Background Jobs</field>
        <field name="res_model">bg.job</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No background jobs found!
            </p>
            <p>
                Background jobs are created automatically when you perform operations
                that take a long time to complete. They allow you to continue working
                while the system processes your request in the background.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_bg_job_root"
              name="Background Jobs"
              parent="base.menu_custom"
              sequence="100"/>

    <menuitem id="menu_bg_job"
              name="Jobs"
              parent="menu_bg_job_root"
              action="action_bg_job"
              sequence="10"/>

</odoo>
