<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_bg_job_runner" model="ir.cron">
        <field name="name">Background Job Runner</field>
        <field name="model_id" ref="model_bg_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_enqueued_jobs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
    </record>

    <record id="ir_cron_bg_job_monitor" model="ir.cron">
        <field name="name">Background Job Monitor</field>
        <field name="model_id" ref="model_bg_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_running_jobs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
    </record>

</odoo>
