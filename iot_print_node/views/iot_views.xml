<odoo>
    <record id="iot_box_view_form" model="ir.ui.view">
        <field name="name">iot.box.view.form</field>
        <field name="model">iot.box</field>
        <field name="inherit_id" ref="iot.iot_box_view_form"/>
        <field name="arch" type="xml">
            <button position="after">
                <button name="action_print_update_devices" invisible="not print_node_api_key" type="object" string="Update printnode printers" class="btn btn-secondary"/>
            </button>
        </field>
    </record>
</odoo>
