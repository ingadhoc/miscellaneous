<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_statement_import_form" model="ir.ui.view">
        <field name="name">account.statement.import.form.ux</field>
        <field name="model">account.statement.import</field>
        <field
            name="inherit_id"
            ref="account_statement_import_file.account_statement_import_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//footer/button[@name='import_file_button']" position="after">
                <button
                    name="action_test_import"
                    string="Test Import"
                    type="object"
                    class="btn-secondary"
                    invisible="not statement_file"
                    help="Report what would be imported, without saving anything"
                />
            </xpath>
        </field>
    </record>
    <record
        id="account_statement_import_sheet_mapping_test_form"
        model="ir.ui.view"
    >
        <field name="name">account.statement.import.sheet.mapping.test.form</field>
        <field name="model">account.statement.import.sheet.mapping.test</field>
        <field name="arch" type="xml">
            <form>
                <p
                    class="text-muted"
                >The file is read with this mapping and the result is reported without saving anything: no statement and no transaction is created.</p>
                <group>
                    <field name="mapping_id" />
                    <field name="journal_id" />
                    <field
                        name="statement_file"
                        filename="statement_filename"
                        required="1"
                    />
                    <field name="statement_filename" invisible="1" />
                </group>
                <footer>
                    <button
                        name="action_test"
                        string="Test Import"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Close" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
