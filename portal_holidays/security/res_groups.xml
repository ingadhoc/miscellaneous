<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="privilege_portal_advanced_holiday">
        <field name="name">Advanced Holidays</field>
        <field name="description">Advanced holidays permissions</field>
        <field name="category_id" ref="portal_backend.category_portal_advanced"/>
        <field name="sequence">10</field>
    </record>

    <record model="res.groups" id="group_portal_backend_holiday" >
        <field name="name">Portal Backend: Holidays</field>
        <field name="comment">Allows portal backend users to access the application dashboard to request leave days.</field>
        <field name="privilege_id" ref="privilege_portal_advanced_holiday"/>
        <field name="implied_ids" eval="[Command.link(ref('portal_backend.group_portal_backend'))]"/>
    </record>
</odoo>
